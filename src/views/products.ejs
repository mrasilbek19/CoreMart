<%- include('includes/header') %>

    <!--  LOOP PRODUCTS: START  -->
    <% products.map(function(value, key){ %>
        <tbody style="background: white">
            <td>
                <%= key + 1 %>
            </td>
            <td>
                <%= value.productName%>
            </td>
            <td>
                <%= value.productCollection%>
            </td>
            <td>
                <%=value.productVolume%>
            </td>
            <td>
                <%= value.productPrice%>
            </td>
            <td>
                <%= value.productLeftCount%>
            </td>
        </tbody>
        <% })%>

            <%- include('includes/footer') %>