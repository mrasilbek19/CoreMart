<%- include('includes/header') %>
    <link rel="stylesheet" type="text/css" href="/css/login.css" />

    <body>
        <form class="login-container" action="/admin/login" method="POST">
            <div class="login-frame">

                <div class="login-top">
                    <span class="page-eyebrow">PERFUMIA ADMIN</span>
                    <h1>Welcome Back</h1>
                    <span class="heading-rule" aria-hidden="true"></span>

                    <div>
                        Go back
                        <a href="/admin">Home</a>
                    </div>

                    <p>
                        Not registered yet?
                        <a href="/admin/signup">
                            Signup
                        </a>
                    </p>
                </div>

                <div class="login-input-frame">

                    <div class="login-input-container">
                        <label>Shop *</label>

                        <input type="text" name="login" class="member-nick" placeholder="Username or Email" value=""
                            required />
                    </div>

                    <div class="login-input-container">
                        <label>Password *</label>

                        <input type="password" name="memberPassword" class="member-password" placeholder="Password"
                            value="" required />
                    </div>

                </div>

                <button class="login-btn btn" type="submit">
                    Login
                </button>

            </div>
        </form>

        <%- include('includes/footer') %>
